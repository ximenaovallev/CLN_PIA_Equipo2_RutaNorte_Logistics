# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# Todos los valores de este archivo son de ejemplo (no son credenciales reales).

# --- Base de datos (docker compose usa estos tres para PostgreSQL) ---
POSTGRES_USER=rutanorte
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=rutanorte
# Cadena de conexión de la app. En compose el host es el servicio "db"; en Render la inyecta la base de datos.
DATABASE_URL=postgresql://rutanorte:cambia_esta_clave@db:5432/rutanorte

# --- Aplicación ---
APP_ENV=desarrollo
LOG_LEVEL=INFO
PORT=8000

# --- Supuestos pendientes de validar (vacío = sin tope / sin caducidad). Ver docs/architecture/supuestos.md ---
LIMITE_PESO_KG=
LIMITE_VOLUMEN_M3=
DIAS_CONSERVACION_EVIDENCIAS=
ROLES_QUE_CANCELAN=Operaciones
